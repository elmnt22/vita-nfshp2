+/* HP2 direct GXM path: the GXM texture of a GL texture name, marked used this
+ * frame (vitaGL frees a deleted texture at once unless recently used). */
+SceGxmTexture *vglHp2UseTexture(GLuint name) {
+	if (name >= TEXTURES_NUM)
+		return NULL;
+	texture *tex = &texture_slots[name];
+#ifndef TEXTURES_SPEEDHACK
+	tex->last_frame = vgl_framecount;
+#endif
+	return &tex->gxm_tex;
+}
+
+/* Same for a buffer object (GL buffer names are vbo pointers). */
+void *vglHp2UseBuffer(GLuint name) {
+	vbo *gpu_buf = (vbo *)name;
+	if (!gpu_buf)
+		return NULL;
+	gpu_buf->last_frame = vgl_framecount;
+	return gpu_buf->ptr;
+}
