+/* HP2 direct GXM path: after the port issued GXM state/draws itself,
+ * re-apply the state vitaGL sets eagerly (viewport, depth, stencil) and mark
+ * its lazily uploaded uniforms dirty, so the next vitaGL draw is correct. */
+void vglHp2Invalidate(void) {
+	vglSetViewport(gxm_context, x_port, x_scale, y_port, y_scale, z_port, z_scale);
+	change_depth_func();
+	refresh_stencil_settings();
+	dirty_shader_vert_unifs = GL_TRUE;
+	dirty_shader_frag_unifs = GL_TRUE;
+	vglRestoreVertexUniformBuffer();
+	vglRestoreFragmentUniformBuffer();
+}
